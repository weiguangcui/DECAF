---
const rawBASE = (import.meta as any).env?.BASE_URL ?? '/';
const BASE = rawBASE.endsWith('/') ? rawBASE : `${rawBASE}/`;
const SUBSCRIBE_URL = 'https://buttondown.com/department_of_theoretical_physics';
const ONLINE_MEETING_URL = 'https://teams.microsoft.com/meet/355120697890655?p=thM0xIAEB3JAVvK7ZD';
---
<footer>
  <span>
    &copy; {new Date().getFullYear()} DeCAF (DFT-CIAFF joint seminar series)
    is sponsored by <a href="https://www.uam.es/ciencias/facultad/departamentos/fisica-teorica" target="_blank" rel="noopener">DFT, UAM</a>.
  </span>
  <div class="footer-links">
    <a href={SUBSCRIBE_URL} target="_blank" rel="noopener">Subscribe</a>
    <span class="sep">•</span>
    <a href={`${BASE}feed.xml`}>RSS</a>
    <span class="sep">•</span>
    <a href="https://www.youtube.com/@DFisicaTe%C3%B3ricaUAM" target="_blank" rel="noopener">Youtube Channel</a>
    <span class="sep">•</span>
    <a class="meeting-link" href={ONLINE_MEETING_URL} target="_blank" rel="noopener">Online meeting link</a>
  </div>
</footer>

<style>
  footer {
    color: var(--text-secondary);
    font-size: .8em;
    margin: 1em auto;
    max-width: 1400px;
    padding: 1em 2em;
    text-align: center;
    width: 100%;
  }
  .footer-links {
    margin-top: .5em;
  }
  .footer-links a {
    color: inherit;
    text-decoration: none;
    margin: 0 .25em;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
  .footer-links a.meeting-link {
    color: #0078d4;
    font-weight: 600;
  }
  :root.theme-dark .footer-links a.meeting-link {
    color: #60a5fa;
  }
  .footer-links .sep { opacity: .6; margin: 0 .25em; }
</style>
